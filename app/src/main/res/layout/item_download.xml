<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginVertical="6dp"
	app:cardBackgroundColor="@color/taru_surface_high"
	app:cardCornerRadius="16dp"
	app:cardElevation="0dp"
	app:strokeColor="@color/taru_outline"
	app:strokeWidth="1dp">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/constraintLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="122dp"
		android:padding="12dp">

		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/imageView_cover"
			android:layout_width="72dp"
			android:layout_height="88dp"
			android:background="@drawable/bg_taru_cover_peek"
			android:scaleType="centerCrop"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintVertical_bias="0"
			app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Cover.Medium"
			tools:src="@tools:sample/backgrounds/scenic" />

		<TextView
			android:id="@+id/textView_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="8dp"
			android:ellipsize="end"
			android:fontFamily="sans-serif-medium"
			android:maxLines="1"
			android:textColor="@color/taru_text_primary"
			android:textSize="16sp"
			app:layout_constraintEnd_toStartOf="@id/button_expand"
			app:layout_constraintStart_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toTopOf="@id/imageView_cover"
			tools:text="The Stellar Swordmaster" />

		<org.koitharu.kotatsu.core.ui.widgets.CheckableImageButton
			android:id="@+id/button_expand"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@string/expand"
			android:scaleType="center"
			android:visibility="gone"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="@id/imageView_cover"
			app:srcCompat="?expandCollapseIndicator"
			app:tint="@color/taru_text_secondary"
			tools:visibility="visible" />

		<TextView
			android:id="@+id/textView_status"
			android:layout_width="wrap_content"
			android:layout_height="26dp"
			android:layout_marginStart="12dp"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_taru_download_status"
			android:ellipsize="end"
			android:fontFamily="sans-serif-medium"
			android:gravity="center"
			android:maxWidth="150dp"
			android:minWidth="74dp"
			android:paddingHorizontal="10dp"
			android:singleLine="true"
			android:textColor="#FFFFFF"
			android:textSize="12sp"
			app:layout_constraintStart_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toBottomOf="@id/textView_title"
			tools:text="@string/manga_downloading_" />

		<TextView
			android:id="@+id/textView_percent"
			android:layout_width="wrap_content"
			android:layout_height="26dp"
			android:layout_marginStart="6dp"
			android:fontFamily="sans-serif-medium"
			android:gravity="center"
			android:textColor="@color/taru_text_muted"
			android:textSize="12sp"
			app:layout_constraintBottom_toBottomOf="@id/textView_status"
			app:layout_constraintStart_toEndOf="@id/textView_status"
			app:layout_constraintTop_toTopOf="@id/textView_status"
			tools:text="25%" />

		<TextView
			android:id="@+id/textView_details"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginTop="6dp"
			android:layout_marginEnd="8dp"
			android:ellipsize="end"
			android:fontFamily="sans-serif"
			android:maxLines="2"
			android:textColor="@color/taru_text_muted"
			android:textSize="12sp"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toBottomOf="@id/textView_status"
			tools:text="3 chapters saved - last downloaded recently" />

		<com.google.android.material.progressindicator.LinearProgressIndicator
			android:id="@+id/progressBar"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginTop="8dp"
			android:layout_marginEnd="8dp"
			app:indicatorColor="@color/taru_accent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toEndOf="@id/imageView_cover"
			app:layout_constraintTop_toBottomOf="@id/textView_details"
			app:trackColor="@color/taru_outline"
			tools:progress="25" />

		<org.koitharu.kotatsu.core.ui.widgets.NestedRecyclerView
			android:id="@+id/recyclerView_chapters"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:background="@drawable/bg_taru_panel"
			android:clipToOutline="true"
			android:clipToPadding="false"
			android:fadeScrollbars="false"
			android:nestedScrollingEnabled="false"
			android:orientation="vertical"
			android:outlineProvider="background"
			android:paddingVertical="8dp"
			android:scrollbarStyle="insideOverlay"
			android:scrollbars="vertical"
			android:visibility="gone"
			app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/progressBar"
			app:maxHeight="240dp"
			tools:listitem="@layout/item_chapter_download"
			tools:visibility="visible" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_pause"
			style="?borderlessButtonStyle"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@string/pause"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:text=""
			android:visibility="gone"
			app:backgroundTint="@null"
			app:icon="@drawable/ic_action_pause"
			app:iconGravity="textStart"
			app:iconPadding="0dp"
			app:iconTint="@color/taru_text_secondary"
			tools:visibility="visible" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_resume"
			style="?borderlessButtonStyle"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@string/resume"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:text=""
			android:visibility="gone"
			app:backgroundTint="@null"
			app:icon="@drawable/ic_action_resume"
			app:iconGravity="textStart"
			app:iconPadding="0dp"
			app:iconTint="@color/taru_text_secondary"
			tools:visibility="visible" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_skip"
			style="?borderlessButtonStyle"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@string/skip"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:text=""
			android:visibility="gone"
			app:backgroundTint="@null"
			app:icon="@drawable/ic_action_skip"
			app:iconGravity="textStart"
			app:iconPadding="0dp"
			app:iconTint="@color/taru_text_secondary"
			tools:visibility="visible" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_skip_all"
			style="?borderlessButtonStyle"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@string/skip_all"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:text=""
			android:visibility="gone"
			app:backgroundTint="@null"
			app:icon="@drawable/ic_action_skip"
			app:iconGravity="textStart"
			app:iconPadding="0dp"
			app:iconTint="@color/taru_text_secondary"
			tools:visibility="visible" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_cancel"
			style="?borderlessButtonStyle"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_taru_download_action"
			android:contentDescription="@android:string/cancel"
			android:insetLeft="0dp"
			android:insetTop="0dp"
			android:insetRight="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:text=""
			android:visibility="gone"
			app:backgroundTint="@null"
			app:icon="@drawable/ic_remove_x"
			app:iconGravity="textStart"
			app:iconPadding="0dp"
			app:iconTint="@null"
			tools:visibility="visible" />

		<androidx.constraintlayout.helper.widget.Flow
			android:id="@+id/flow_buttons"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			app:constraint_referenced_ids="button_pause,button_resume,button_skip,button_skip_all,button_cancel"
			app:flow_horizontalAlign="end"
			app:flow_horizontalBias="1"
			app:flow_horizontalGap="8dp"
			app:flow_horizontalStyle="packed"
			app:flow_wrapMode="chain"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/recyclerView_chapters" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
