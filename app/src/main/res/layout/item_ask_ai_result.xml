<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_taru_home_feature"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:padding="14dp">

	<org.koitharu.kotatsu.image.ui.CoverImageView
		android:id="@+id/imageView_cover"
		android:layout_width="78dp"
		android:layout_height="114dp"
		android:background="@drawable/bg_taru_cover_peek"
		android:scaleType="centerCrop"
		app:allowRgb565="true"
		app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Cover"
		tools:ignore="ContentDescription"
		tools:src="@tools:sample/backgrounds/scenic[3]" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/textView_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:fontFamily="sans-serif-medium"
			android:maxLines="2"
			android:textColor="@color/taru_text_primary"
			android:textSize="17sp"
			tools:text="The Greatest Estate Developer" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="9dp"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/textView_type"
				android:layout_width="wrap_content"
				android:layout_height="26dp"
				android:background="@drawable/bg_taru_home_chip_active"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:minWidth="62dp"
				android:paddingHorizontal="10dp"
				android:textColor="@color/taru_text_primary"
				android:textSize="11sp"
				android:textAllCaps="true"
				tools:text="Manhwa" />

			<TextView
				android:id="@+id/textView_source"
				android:layout_width="wrap_content"
				android:layout_height="26dp"
				android:layout_marginStart="8dp"
				android:background="@drawable/bg_taru_home_chip"
				android:ellipsize="end"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:maxWidth="132dp"
				android:paddingHorizontal="10dp"
				android:singleLine="true"
				android:textColor="@color/taru_text_secondary"
				android:textSize="11sp"
				android:textAllCaps="true"
				tools:text="WeebCentral" />
		</LinearLayout>

		<TextView
			android:id="@+id/textView_reason"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:ellipsize="end"
			android:fontFamily="sans-serif"
			android:lineSpacingExtra="1dp"
			android:maxLines="3"
			android:textColor="@color/taru_text_secondary"
			android:textSize="13sp"
			tools:text="Matched by title, genre, and source tags." />
	</LinearLayout>
</LinearLayout>
