<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_taru_panel"
	android:clipToOutline="true"
	android:gravity="top"
	android:orientation="horizontal"
	android:padding="13dp">

	<org.koitharu.kotatsu.image.ui.CoverImageView
		android:id="@+id/imageView_cover"
		android:layout_width="78dp"
		android:layout_height="112dp"
		android:background="@drawable/bg_taru_cover_peek"
		android:scaleType="centerCrop"
		app:allowRgb565="true"
		app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Cover"
		tools:ignore="ContentDescription"
		tools:src="@tools:sample/backgrounds/scenic[4]" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/textView_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:fontFamily="sans-serif"
			android:lineSpacingExtra="1dp"
			android:maxLines="2"
			android:textColor="@color/taru_text_primary"
			android:textSize="19sp"
			tools:text="Tonari no Seki no Yatsu ga Souiu Me de Mitekuru" />

		<LinearLayout
			android:id="@+id/layoutChapters"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:orientation="vertical" />
	</LinearLayout>

</LinearLayout>
