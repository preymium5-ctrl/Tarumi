<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_taru_home_root"
	android:orientation="vertical">

	<!-- Header Area -->
	<com.google.android.material.card.MaterialCardView
		android:layout_width="72dp"
		android:layout_height="72dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="28dp"
		app:cardCornerRadius="36dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/taru_outline"
		app:strokeWidth="1dp"
		app:cardBackgroundColor="@color/taru_surface_soft">

		<ImageView
			android:layout_width="38dp"
			android:layout_height="38dp"
			android:layout_gravity="center"
			android:contentDescription="@null"
			android:src="@drawable/ic_app_update"
			app:tint="@color/taru_accent" />
	</com.google.android.material.card.MaterialCardView>

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="24dp"
		android:layout_marginTop="16dp"
		android:gravity="center_horizontal"
		android:text="@string/app_update_available"
		android:textAppearance="?textAppearanceHeadline5"
		android:textColor="@color/taru_text_primary"
		android:fontFamily="@font/outfit"
		android:textStyle="bold" />

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="8dp"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/textView_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/taru_text_secondary"
			android:textSize="14sp"
			android:fontFamily="@font/outfit"
			tools:text="Version 2.3.4" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="8dp"
			android:textColor="@color/taru_text_muted"
			android:textSize="14sp"
			android:text="&#8226;" />

		<TextView
			android:id="@+id/textView_size"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/taru_text_secondary"
			android:textSize="14sp"
			android:fontFamily="@font/outfit"
			tools:text="Size: 12.4 MB" />
	</LinearLayout>

	<!-- Progress Indicator Area -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_progress"
		style="?materialCardViewOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="16dp"
		android:visibility="gone"
		app:cardCornerRadius="16dp"
		app:strokeColor="@color/taru_outline"
		app:strokeWidth="1dp"
		app:cardBackgroundColor="@color/taru_surface_soft"
		tools:visibility="visible">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="16dp">

			<RelativeLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp">

				<TextView
					android:id="@+id/textView_progress_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentStart="true"
					android:text="@string/manga_downloading_"
					android:textColor="@color/taru_text_primary"
					android:textSize="14sp"
					android:fontFamily="@font/outfit"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/textView_progress_percent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentEnd="true"
					android:textColor="@color/taru_accent"
					android:textSize="14sp"
					android:fontFamily="@font/outfit"
					android:textStyle="bold"
					tools:text="45%" />

			</RelativeLayout>

			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progressBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:max="100"
				app:indicatorColor="@color/taru_accent"
				app:trackColor="@color/taru_outline"
				app:trackCornerRadius="6dp"
				app:trackThickness="10dp" />

		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Error Message -->
	<TextView
		android:id="@+id/textView_error"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="8dp"
		android:textColor="?colorError"
		android:fontFamily="@font/outfit"
		android:visibility="gone"
		tools:text="@string/error_corrupted_file"
		tools:visibility="visible" />

	<!-- Release Notes Card -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_changelog"
		style="?materialCardViewOutlinedStyle"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="8dp"
		app:cardCornerRadius="20dp"
		app:strokeColor="@color/taru_outline"
		app:strokeWidth="1dp"
		app:cardBackgroundColor="@color/taru_surface">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="16dp"
				android:paddingTop="16dp"
				android:paddingBottom="10dp"
				android:text="Changelog"
				android:textColor="@color/taru_text_primary"
				android:textSize="15sp"
				android:fontFamily="@font/outfit"
				android:textStyle="bold" />

			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="@color/taru_outline" />

			<ScrollView
				android:id="@+id/scrollView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="8dp">

				<TextView
					android:id="@+id/textView_content"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:textColor="@color/taru_text_primary"
					android:textSize="14sp"
					android:fontFamily="@font/outfit"
					tools:text="@tools:sample/lorem/random" />

			</ScrollView>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Discord Redirect Button -->
	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_discord"
		style="@style/Widget.Material3.Button.OutlinedButton.Icon"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="8dp"
		android:text="Join our Discord"
		android:textColor="@color/taru_text_primary"
		android:textSize="14sp"
		android:fontFamily="@font/outfit"
		android:textStyle="bold"
		app:backgroundTint="@color/taru_surface_button"
		app:icon="@drawable/ic_discord"
		app:iconTint="@color/taru_accent"
		app:strokeColor="@color/taru_outline"
		app:strokeWidth="1dp"
		app:cornerRadius="16dp" />

	<!-- Bottom Docked Toolbar -->
	<com.google.android.material.dockedtoolbar.DockedToolbarLayout
		android:id="@+id/docked_toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fitsSystemWindows="false"
		android:background="@color/taru_surface_soft">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="@color/taru_outline" />

			<FrameLayout
				android:id="@+id/docked_toolbar_child"
				android:layout_width="match_parent"
				android:layout_height="@dimen/m3_comp_toolbar_docked_container_height"
				android:paddingHorizontal="16dp">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_cancel"
					style="@style/Widget.Material3.Button.TextButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical|start"
					android:text="@android:string/cancel"
					android:textColor="@color/taru_text_secondary"
					android:fontFamily="@font/outfit"
					android:textStyle="bold" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_update"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical|end"
					android:enabled="false"
					android:text="@string/update"
					android:textColor="@color/taru_on_accent"
					app:backgroundTint="@color/taru_accent"
					android:fontFamily="@font/outfit"
					android:textStyle="bold"
					app:cornerRadius="16dp" />

			</FrameLayout>
		</LinearLayout>
	</com.google.android.material.dockedtoolbar.DockedToolbarLayout>

</LinearLayout>
