<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="12dp"
	android:layout_marginVertical="6dp"
	android:background="@drawable/bg_taru_chapter_card"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingTop="14dp"
		android:paddingEnd="14dp"
		android:paddingBottom="14dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textView_title"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:drawablePadding="8dp"
					android:ellipsize="end"
					android:fontFamily="sans-serif-medium"
					android:maxLines="2"
					android:textColor="@color/taru_text_primary"
					android:textSize="15sp"
					tools:text="Chapter 394: Chapter 394" />

				<TextView
					android:id="@+id/textViewNew"
					android:layout_width="wrap_content"
					android:layout_height="18dp"
					android:layout_marginStart="8dp"
					android:background="@drawable/bg_taru_new_label"
					android:fontFamily="sans-serif-bold"
					android:gravity="center"
					android:letterSpacing="0.05"
					android:minWidth="34dp"
					android:paddingHorizontal="6dp"
					android:text="@string/notification_new_label"
					android:textColor="#FFFFFF"
					android:textSize="9sp"
					android:visibility="gone"
					tools:visibility="visible" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textView_date"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:fontFamily="sans-serif"
					android:singleLine="true"
					android:textColor="@color/taru_text_secondary"
					android:textSize="12sp"
					tools:text="Mar 25, 2026" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="6dp"
					android:layout_marginEnd="6dp"
					android:fontFamily="sans-serif"
					android:singleLine="true"
					android:text="•"
					android:textColor="@color/taru_text_muted"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/textView_source"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:fontFamily="sans-serif-medium"
					android:letterSpacing="0.05"
					android:singleLine="true"
					android:textAllCaps="true"
					android:textColor="@color/taru_text_muted"
					android:textSize="10sp"
					tools:text="WEEBCENTRAL" />

				<View
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:layout_weight="1" />

				<ImageView
					android:id="@+id/imageView_downloaded"
					android:layout_width="14dp"
					android:layout_height="14dp"
					android:layout_marginStart="8dp"
					android:contentDescription="@string/downloaded"
					android:visibility="gone"
					app:srcCompat="@drawable/ic_storage"
					app:tint="@color/taru_accent"
					tools:visibility="visible" />

				<ImageView
					android:id="@+id/imageView_bookmarked"
					android:layout_width="14dp"
					android:layout_height="14dp"
					android:layout_marginStart="6dp"
					android:contentDescription="@string/bookmarks"
					android:visibility="gone"
					app:srcCompat="@drawable/ic_bookmark"
					app:tint="@color/taru_accent"
					tools:visibility="visible" />
			</LinearLayout>
		</LinearLayout>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/textView_status"
				android:layout_width="wrap_content"
				android:layout_height="22dp"
				android:background="@drawable/bg_taru_chapter_status"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:letterSpacing="0.05"
				android:minWidth="64dp"
				android:paddingHorizontal="8dp"
				android:textColor="@color/taru_text_secondary"
				android:textSize="9sp"
				tools:text="UNREAD" />

			<ImageView
				android:id="@+id/imageView_play"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginStart="10dp"
				android:contentDescription="@string/read"
				android:padding="8dp"
				android:background="@drawable/bg_circle_button"
				app:srcCompat="@drawable/ic_play"
				app:tint="@color/taru_accent" />
		</LinearLayout>
	</LinearLayout>

	<ProgressBar
		android:id="@+id/progressChapter"
		style="?android:attr/progressBarStyleHorizontal"
		android:layout_width="match_parent"
		android:layout_height="4dp"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="12dp"
		android:indeterminate="false"
		android:max="100"
		android:progressDrawable="@drawable/bg_taru_chapter_progress" />
</LinearLayout>
