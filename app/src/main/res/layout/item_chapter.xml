<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="12dp"
	android:layout_marginVertical="7dp"
	android:background="@drawable/bg_taru_chapter_card"
	android:baselineAligned="false"
	android:gravity="center_vertical"
	android:minHeight="108dp"
	android:orientation="horizontal"
	android:paddingStart="14dp"
	android:paddingTop="12dp"
	android:paddingEnd="12dp"
	android:paddingBottom="12dp">

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/textView_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:drawablePadding="8dp"
				android:ellipsize="end"
				android:fontFamily="sans-serif-medium"
				android:maxLines="2"
				android:textColor="@color/taru_text_primary"
				android:textSize="17sp"
				tools:text="Chapter 394: Chapter 394" />

			<TextView
				android:id="@+id/textViewNew"
				android:layout_width="wrap_content"
				android:layout_height="24dp"
				android:layout_marginStart="10dp"
				android:background="@drawable/bg_taru_new_label"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:letterSpacing="0.08"
				android:minWidth="44dp"
				android:paddingHorizontal="10dp"
				android:text="@string/notification_new_label"
				android:textColor="#FFFFFF"
				android:textSize="10sp"
				android:visibility="gone"
				tools:visibility="visible" />
		</LinearLayout>

		<TextView
			android:id="@+id/textView_date"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:ellipsize="end"
			android:fontFamily="sans-serif"
			android:singleLine="true"
			android:textColor="@color/taru_text_muted"
			android:textSize="12sp"
			tools:text="Mar 25, 2026" />

		<TextView
			android:id="@+id/textView_source"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:ellipsize="end"
			android:fontFamily="sans-serif-medium"
			android:letterSpacing="0.12"
			android:singleLine="true"
			android:textAllCaps="true"
			android:textColor="@color/taru_text_soft"
			android:textSize="10sp"
			tools:text="WEEBCENTRAL | EN" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ProgressBar
				android:id="@+id/progressChapter"
				style="?android:attr/progressBarStyleHorizontal"
				android:layout_width="0dp"
				android:layout_height="5dp"
				android:layout_weight="1"
				android:indeterminate="false"
				android:max="100"
				android:progressDrawable="@drawable/bg_taru_chapter_progress" />

			<TextView
				android:id="@+id/textView_status"
				android:layout_width="wrap_content"
				android:layout_height="28dp"
				android:layout_marginStart="12dp"
				android:background="@drawable/bg_taru_chapter_status"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:letterSpacing="0.12"
				android:minWidth="76dp"
				android:paddingHorizontal="12dp"
				android:textColor="@color/taru_text_secondary"
				android:textSize="10sp"
				tools:text="UNREAD" />
		</LinearLayout>
	</LinearLayout>

	<ImageView
		android:id="@+id/imageView_play"
		android:layout_width="34dp"
		android:layout_height="34dp"
		android:layout_marginStart="10dp"
		android:contentDescription="@string/read"
		android:padding="7dp"
		app:srcCompat="@drawable/ic_play"
		app:tint="@color/taru_accent" />

	<ImageView
		android:id="@+id/imageView_bookmarked"
		android:layout_width="1dp"
		android:layout_height="1dp"
		android:visibility="gone"
		app:srcCompat="@drawable/ic_bookmark" />

	<ImageView
		android:id="@+id/imageView_downloaded"
		android:layout_width="1dp"
		android:layout_height="1dp"
		android:visibility="gone"
		app:srcCompat="@drawable/ic_storage" />
</LinearLayout>
