<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/homeRoot"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/transparent"
	android:clipToPadding="false"
	android:fillViewport="true"
	android:paddingHorizontal="14dp"
	android:paddingTop="0dp"
	android:paddingBottom="20dp"
	android:scrollbars="none">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<!-- Featured comics card -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:background="@drawable/bg_taru_home_feature"
			android:clipToOutline="true"
			android:elevation="2dp"
			android:orientation="vertical"
			android:paddingHorizontal="20dp"
			android:paddingTop="22dp"
			android:paddingBottom="18dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_taru_home_badge"
				android:drawablePadding="8dp"
				android:fontFamily="sans-serif-medium"
				android:gravity="center_vertical"
				android:letterSpacing="0.16"
				android:minHeight="32dp"
				android:paddingHorizontal="14dp"
				android:paddingVertical="6dp"
				android:text="FEATURED COMICS"
				android:textColor="#2B3B50"
				android:textSize="11sp"
				app:drawableStartCompat="@drawable/ic_book_page"
				app:drawableTint="#E0B95B"
				tools:ignore="HardcodedText" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textFeaturedType"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_taru_home_chip_active"
					android:fontFamily="sans-serif"
					android:gravity="center"
					android:minHeight="32dp"
					android:paddingHorizontal="14dp"
					android:paddingVertical="6dp"
					android:text="Comic"
					android:textColor="#0E1A2D"
					android:textSize="13sp"
					tools:ignore="HardcodedText" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:background="@drawable/bg_taru_home_chip"
					android:fontFamily="sans-serif"
					android:gravity="center"
					android:minHeight="32dp"
					android:paddingHorizontal="14dp"
					android:paddingVertical="6dp"
					android:text="Ongoing"
					android:textColor="#2C394A"
					android:textSize="13sp"
					tools:ignore="HardcodedText" />
			</LinearLayout>

			<TextView
				android:id="@+id/textFeaturedTitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:fontFamily="sans-serif"
				android:lineSpacingMultiplier="1.05"
				android:text=""
				android:textColor="#07162B"
				android:textSize="29sp"
				android:textStyle="normal"
				tools:ignore="HardcodedText" />

			<TextView
				android:id="@+id/textFeaturedDescription"
				android:layout_width="match_parent"
				android:layout_height="58dp"
				android:layout_marginTop="10dp"
				android:ellipsize="end"
				android:fontFamily="sans-serif"
				android:lineSpacingExtra="2dp"
				android:maxLines="3"
				android:text=""
				android:textColor="#465569"
				android:textSize="13sp"
				tools:ignore="HardcodedText" />

			<HorizontalScrollView
				android:id="@+id/featuredCarouselScroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:clipToPadding="false"
				android:overScrollMode="never"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/comicsCarousel"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:paddingEnd="14dp" />
			</HorizontalScrollView>
		</LinearLayout>

		<!-- Trending section -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="54dp"
			android:background="@drawable/bg_taru_home_feature"
			android:clipToOutline="true"
			android:elevation="2dp"
			android:orientation="vertical"
			android:paddingHorizontal="20dp"
			android:paddingTop="24dp"
			android:paddingBottom="22dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:fontFamily="sans-serif"
					android:text="@string/trending_title"
					android:textColor="#07162B"
					android:textSize="30sp"
					android:textStyle="normal" />

				<TextView
					android:id="@+id/buttonSeeMore"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="?attr/selectableItemBackground"
					android:drawablePadding="4dp"
					android:fontFamily="sans-serif"
					android:gravity="center_vertical"
					android:paddingHorizontal="6dp"
					android:paddingVertical="6dp"
					android:text="@string/see_more"
					android:textColor="#465569"
					android:textSize="15sp"
					app:drawableEndCompat="@drawable/ic_taru_chevron_right"
					app:drawableTint="#465569" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/trendingGrid"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical" />

			<FrameLayout
				android:id="@+id/trendingLoading"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginVertical="20dp"
				android:visibility="gone"
				tools:visibility="visible">

				<com.google.android.material.progressindicator.CircularProgressIndicator
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:indeterminate="true"
					app:indicatorSize="28dp" />
			</FrameLayout>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/manhuaRecommendationSection"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="42dp"
			android:orientation="vertical"
			android:paddingHorizontal="4dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:drawablePadding="4dp"
				android:fontFamily="sans-serif"
				android:gravity="center_vertical"
				android:text="@string/manhua_recommendation"
				android:textColor="#07162B"
				android:textSize="22sp"
				app:drawableEndCompat="@drawable/ic_taru_chevron_right"
				app:drawableTint="#465569" />

			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:clipToPadding="false"
				android:overScrollMode="never"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/manhuaRecommendationList"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:paddingEnd="16dp" />
			</HorizontalScrollView>

			<FrameLayout
				android:id="@+id/manhuaRecommendationLoading"
				android:layout_width="match_parent"
				android:layout_height="96dp"
				android:visibility="gone"
				tools:visibility="visible">

				<com.google.android.material.progressindicator.CircularProgressIndicator
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:indeterminate="true"
					app:indicatorSize="28dp" />
			</FrameLayout>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/mangaRecommendationSection"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="42dp"
			android:orientation="vertical"
			android:paddingHorizontal="4dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:drawablePadding="4dp"
				android:fontFamily="sans-serif"
				android:gravity="center_vertical"
				android:text="@string/manga_recommendation"
				android:textColor="#07162B"
				android:textSize="22sp"
				app:drawableEndCompat="@drawable/ic_taru_chevron_right"
				app:drawableTint="#465569" />

			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:clipToPadding="false"
				android:overScrollMode="never"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/mangaRecommendationList"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:paddingEnd="16dp" />
			</HorizontalScrollView>

			<FrameLayout
				android:id="@+id/mangaRecommendationLoading"
				android:layout_width="match_parent"
				android:layout_height="96dp"
				android:visibility="gone"
				tools:visibility="visible">

				<com.google.android.material.progressindicator.CircularProgressIndicator
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:indeterminate="true"
					app:indicatorSize="28dp" />
			</FrameLayout>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/recentUpdatesSection"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="54dp"
			android:orientation="vertical"
			android:paddingHorizontal="4dp"
			android:paddingBottom="4dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_taru_home_badge"
				android:drawablePadding="8dp"
				android:fontFamily="sans-serif-medium"
				android:gravity="center_vertical"
				android:letterSpacing="0.16"
				android:minHeight="30dp"
				android:paddingHorizontal="13dp"
				android:paddingVertical="5dp"
				android:text="@string/live_feed"
				android:textAllCaps="true"
				android:textColor="#2B3B50"
				android:textSize="10sp"
				app:drawableStartCompat="@drawable/ic_taru_history"
				app:drawableTint="#83A8EA" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:fontFamily="sans-serif"
				android:text="@string/recent_updates"
				android:textColor="#07162B"
				android:textSize="30sp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="sans-serif"
				android:lineSpacingExtra="2dp"
				android:text="@string/recent_updates_summary"
				android:textColor="#7A8797"
				android:textSize="15sp" />

			<FrameLayout
				android:id="@+id/recentUpdatesLoading"
				android:layout_width="match_parent"
				android:layout_height="96dp"
				android:layout_marginTop="20dp"
				android:visibility="gone"
				tools:visibility="visible">

				<com.google.android.material.progressindicator.CircularProgressIndicator
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:indeterminate="true"
					app:indicatorSize="28dp" />
			</FrameLayout>

			<LinearLayout
				android:id="@+id/recentUpdatesList"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical" />

			<LinearLayout
				android:id="@+id/recentUpdatesPagination"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:gravity="center"
				android:orientation="vertical" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
