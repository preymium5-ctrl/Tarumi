<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="22dp"
	android:background="@drawable/bg_nsfw_browser_card"
	android:orientation="vertical">

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="match_parent"
		android:layout_height="30dp"
		android:background="@drawable/bg_nsfw_browser_title"
		android:ellipsize="end"
		android:fontFamily="sans-serif-condensed"
		android:gravity="center_vertical"
		android:maxLines="1"
		android:paddingHorizontal="10dp"
		android:shadowColor="#CC5D2028"
		android:shadowDx="1.2"
		android:shadowDy="1.2"
		android:shadowRadius="1.5"
		android:textColor="@android:color/white"
		android:textSize="17sp"
		android:textStyle="bold"
		tools:text="Recently Added Title" />

	<TextView
		android:id="@+id/textView_subtitle"
		android:layout_width="match_parent"
		android:layout_height="28dp"
		android:background="@drawable/bg_nsfw_browser_subtitle"
		android:ellipsize="end"
		android:fontFamily="sans-serif"
		android:gravity="center_vertical"
		android:maxLines="1"
		android:paddingHorizontal="10dp"
		android:textColor="#5E1F27"
		android:textSize="15sp"
		tools:text="Source name" />

	<FrameLayout
		android:id="@+id/layout_cover_stack"
		android:layout_width="match_parent"
		android:layout_height="202dp"
		android:paddingTop="18dp">

		<View
			android:layout_width="106dp"
			android:layout_height="158dp"
			android:layout_gravity="center"
			android:layout_marginEnd="100dp"
			android:background="@drawable/bg_nsfw_browser_stack_dark" />

		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/imageView_back"
			android:layout_width="108dp"
			android:layout_height="158dp"
			android:layout_gravity="center"
			android:layout_marginEnd="36dp"
			android:alpha="0.72"
			android:scaleType="centerCrop"
			app:allowRgb565="true"
			tools:ignore="ContentDescription"
			tools:src="@tools:sample/backgrounds/scenic[2]" />

		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/imageView_cover"
			android:layout_width="156dp"
			android:layout_height="188dp"
			android:layout_gravity="center"
			android:layout_marginStart="44dp"
			android:background="@android:color/white"
			android:elevation="2dp"
			android:scaleType="centerCrop"
			app:allowRgb565="true"
			tools:ignore="ContentDescription"
			tools:src="@tools:sample/backgrounds/scenic[5]" />

	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="2dp"
		android:orientation="vertical">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:text="@string/browser_series"
				android:textColor="@color/taru_text_muted"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/textView_series"
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:ellipsize="end"
				android:maxLines="2"
				android:textColor="#5E1F27"
				android:textSize="15sp"
				tools:text="N/A" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:text="@string/browser_type"
				android:textColor="@color/taru_text_muted"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/textView_type"
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="#5E1F27"
				android:textSize="15sp"
				tools:text="Doujinshi" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:text="@string/browser_language"
				android:textColor="@color/taru_text_muted"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/textView_language"
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="#5E1F27"
				android:textSize="15sp"
				tools:text="English" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				style="@style/TextAppearance.Material3.BodyLarge"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:text="@string/browser_tags"
				android:textColor="@color/taru_text_muted"
				android:textSize="15sp" />

			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chipGroup_tags"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				app:chipSpacingHorizontal="5dp"
				app:chipSpacingVertical="4dp"
				app:singleLine="false"
				tools:ignore="SpeakableTextPresentCheck" />

		</LinearLayout>

	</LinearLayout>

	<TextView
		android:id="@+id/textView_footer"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="14dp"
		android:layout_marginBottom="16dp"
		android:fontFamily="sans-serif"
		android:textColor="#C28186"
		android:textSize="16sp"
		tools:text="Page 1 • Source" />

</LinearLayout>
