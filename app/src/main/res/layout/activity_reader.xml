<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/taru_surface">

	<androidx.fragment.app.FragmentContainerView
		android:id="@+id/container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		tools:background="@color/grey" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_timer"
		style="?materialIconButtonOutlinedStyle"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone"
		app:icon="@drawable/ic_timelapse" />

	<org.koitharu.kotatsu.core.ui.widgets.ZoomControl
		android:id="@+id/zoomControl"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|end"
		android:layout_margin="16dp"
		android:orientation="vertical"
		android:spacing="2dp"
		android:visibility="gone"
		app:layout_dodgeInsetEdges="bottom"
		tools:visibility="visible" />

	<org.koitharu.kotatsu.reader.ui.ReaderInfoBarView
		android:id="@+id/infoBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="10dp"
		android:background="@android:color/transparent"
		android:minHeight="34dp"
		android:paddingHorizontal="12dp"
		android:paddingVertical="8dp"
		android:textSize="12sp"
		android:visibility="gone"
		tools:visibility="visible" />

	<org.koitharu.kotatsu.reader.ui.ScrollTimerControlView
		android:id="@+id/timerControl"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:layout_margin="@dimen/screen_padding"
		android:background="@drawable/bg_card"
		android:elevation="@dimen/m3_card_elevated_elevation"
		android:visibility="gone"
		app:layout_dodgeInsetEdges="bottom" />

	<LinearLayout
		android:id="@+id/endChapterActions"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginHorizontal="0dp"
		android:layout_marginBottom="0dp"
		android:background="@color/taru_surface"
		android:elevation="6dp"
		android:gravity="center"
		android:orientation="horizontal"
		android:visibility="gone"
		app:layout_dodgeInsetEdges="bottom"
		tools:visibility="visible">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonEndPrevChapter"
			style="?materialIconButtonStyle"
			android:layout_width="72dp"
			android:layout_height="match_parent"
			android:contentDescription="@string/prev_chapter"
			app:backgroundTint="@color/taru_surface"
			app:cornerRadius="0dp"
			app:icon="@drawable/ic_prev"
			app:iconGravity="textStart"
			app:iconSize="24dp"
			app:iconTint="@color/taru_text_primary" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonEndChapters"
			style="?materialIconButtonStyle"
			android:layout_width="88dp"
			android:layout_height="match_parent"
			android:contentDescription="@string/reader_chapters_list"
			app:backgroundTint="@color/taru_surface"
			app:cornerRadius="0dp"
			app:icon="@drawable/ic_book_page"
			app:iconGravity="textStart"
			app:iconSize="25dp"
			app:iconTint="@color/taru_text_primary" />

		<TextView
			android:id="@+id/textEndChapter"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:fontFamily="@font/outfit"
			android:gravity="center"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/taru_text_primary"
			android:textSize="12sp"
			tools:text="Chapter 125" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonEndNextChapter"
			style="?materialIconButtonStyle"
			android:layout_width="64dp"
			android:layout_height="match_parent"
			android:contentDescription="@string/next_chapter"
			app:backgroundTint="@color/taru_surface"
			app:cornerRadius="0dp"
			app:icon="@drawable/ic_next"
			app:iconGravity="textStart"
			app:iconSize="24dp"
			app:iconTint="@color/taru_text_primary" />
	</LinearLayout>

	<!-- Hidden legacy ViewBinding components to satisfy compiling requirements without visual presence -->
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appbar_top"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone">
		<com.google.android.material.appbar.MaterialToolbar
			android:id="@id/toolbar"
			android:layout_width="0dp"
			android:layout_height="0dp" />
	</com.google.android.material.appbar.AppBarLayout>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_reader_top_back"
		style="?materialIconButtonOutlinedStyle"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_reader_top_settings"
		style="?materialIconButtonOutlinedStyle"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone" />

	<com.google.android.material.dockedtoolbar.DockedToolbarLayout
		android:id="@+id/toolbar_docked"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone">
		<org.koitharu.kotatsu.reader.ui.ReaderActionsView
			android:id="@+id/actionsView"
			android:layout_width="0dp"
			android:layout_height="0dp" />
	</com.google.android.material.dockedtoolbar.DockedToolbarLayout>

	<!-- CUSTOM FLOATING MINIMALIST READER UI LAYOUTS -->

	<!-- 2. Top Left Stack (Back, Title, Home, Download) -->
	<RelativeLayout
		android:id="@+id/customReaderTopLeftStack"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|start"
		android:layout_marginStart="16dp"
		android:layout_marginTop="40dp"
		android:elevation="10dp"
		android:visibility="gone"
		tools:visibility="visible">

		<!-- Back Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_back"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_reader_back"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />

		<!-- Title Pill next to Back Button -->
		<LinearLayout
			android:id="@+id/customReaderTopTitleLayout"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:layout_toEndOf="@id/custom_button_back"
			android:layout_marginStart="8dp"
			android:background="@drawable/bg_reader_pill_dark"
			android:gravity="center"
			android:paddingHorizontal="16dp">

			<TextView
				android:id="@+id/textView_reader_title_custom"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#FFFFFF"
				android:textSize="14sp"
				android:fontFamily="@font/outfit"
				android:ellipsize="end"
				android:maxLines="1"
				android:maxWidth="240dp"
				tools:text="Return of the Mad Demon" />
		</LinearLayout>

		<!-- Home Button under Back Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_home"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_below="@id/custom_button_back"
			android:layout_marginTop="8dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_home"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />

		<!-- Download Button under Home Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_download"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_below="@id/custom_button_home"
			android:layout_marginTop="8dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_download"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />
	</RelativeLayout>

	<!-- 3. Bottom Left Play Button (Auto Scroll) -->
	<com.google.android.material.button.MaterialButton
		android:id="@+id/customButtonPlay"
		style="?materialIconButtonOutlinedStyle"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="bottom|start"
		android:layout_marginStart="16dp"
		android:layout_marginBottom="16dp"
		android:insetLeft="0dp"
		android:insetRight="0dp"
		android:insetTop="0dp"
		android:insetBottom="0dp"
		android:minWidth="0dp"
		android:minHeight="0dp"
		android:padding="12dp"
		android:elevation="10dp"
		android:visibility="gone"
		app:backgroundTint="#E0121212"
		app:strokeWidth="0dp"
		app:cornerRadius="12dp"
		app:icon="@drawable/ic_play"
		app:iconTint="#FFFFFF"
		app:iconPadding="0dp"
		app:iconSize="24dp"
		tools:visibility="visible" />

	<!-- 4. Bottom Center Progress Layout (Prev, Progress Pill, Next) -->
	<LinearLayout
		android:id="@+id/customReaderBottomProgressLayout"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="16dp"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:elevation="10dp"
		android:visibility="gone"
		tools:visibility="visible">

		<!-- Previous Chapter Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_prev_chapter"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_reader_back"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />

		<!-- Progress Text Pill -->
		<LinearLayout
			android:id="@+id/custom_reader_bottom_progress_capsule"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:background="@drawable/bg_reader_pill_dark"
			android:gravity="center"
			android:paddingHorizontal="24dp"
			android:clickable="true"
			android:focusable="true">

			<TextView
				android:id="@+id/textView_reader_page_progress_custom"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#FFFFFF"
				android:textSize="14sp"
				android:fontFamily="@font/outfit"
				tools:text="Episode 198 / 199" />
		</LinearLayout>

		<!-- Next Chapter Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_next_chapter"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginStart="8dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_arrow_forward"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />
	</LinearLayout>

	<!-- 5. Bottom Right Stack (Scroll to Top & Settings) -->
	<LinearLayout
		android:id="@+id/customReaderBottomRightStack"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|end"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="16dp"
		android:orientation="vertical"
		android:elevation="10dp"
		android:visibility="gone"
		tools:visibility="visible">

		<!-- Arrow Up Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_scroll_to_top"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_arrow_up"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />

		<!-- Settings Button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/custom_button_settings"
			style="?materialIconButtonOutlinedStyle"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginTop="8dp"
			android:insetLeft="0dp"
			android:insetRight="0dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:minWidth="0dp"
			android:minHeight="0dp"
			android:padding="12dp"
			app:backgroundTint="#E0121212"
			app:strokeWidth="0dp"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_reader_settings_slider"
			app:iconTint="#FFFFFF"
			app:iconPadding="0dp"
			app:iconSize="24dp" />
	</LinearLayout>

	<org.koitharu.kotatsu.reader.ui.ReaderToastView
		android:id="@+id/toastView"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="20dp"
		android:background="@drawable/bg_reader_indicator"
		android:drawablePadding="6dp"
		android:elevation="1000dp"
		android:singleLine="true"
		android:textAppearance="?attr/textAppearanceBodySmall"
		android:theme="@style/ThemeOverlay.Material3.Dark"
		android:visibility="gone"
		app:layout_dodgeInsetEdges="bottom"
		tools:text="@string/loading_"
		tools:visibility="visible" />

	<LinearLayout
		android:id="@+id/layout_loading"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@drawable/bg_taru_reader_loading"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:outlineProvider="background"
		android:padding="@dimen/screen_padding">

		<ImageView
			android:layout_width="96dp"
			android:layout_height="96dp"
			android:layout_marginBottom="10dp"
			android:contentDescription="@string/app_name"
			android:src="@drawable/tarumi_icon_512" />

		<com.google.android.material.progressindicator.CircularProgressIndicator
			android:id="@+id/progressBar"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:indeterminate="true" />

		<TextView
			android:id="@+id/textView_loading"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:text="@string/loading_"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

	</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
