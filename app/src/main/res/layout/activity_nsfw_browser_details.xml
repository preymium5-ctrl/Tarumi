<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/white"
	tools:context=".settings.sources.catalog.NsfwBrowserDetailsActivity">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@android:color/white"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:paddingHorizontal="18dp"
		android:paddingBottom="116dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="start"
				android:orientation="horizontal">

				<LinearLayout
					android:layout_width="200dp"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<org.koitharu.kotatsu.image.ui.CoverImageView
						android:id="@+id/imageView_cover"
						android:layout_width="200dp"
						android:layout_height="282dp"
						android:background="@android:color/white"
						android:scaleType="centerCrop"
						app:allowRgb565="true"
						tools:ignore="ContentDescription"
						tools:src="@tools:sample/backgrounds/scenic[5]" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_read_online"
						android:layout_width="match_parent"
						android:layout_height="36dp"
						android:layout_marginTop="4dp"
						android:backgroundTint="#556579"
						android:fontFamily="sans-serif-condensed"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:text="@string/read_online"
						android:textAllCaps="false"
						android:textColor="@android:color/white"
						android:textSize="20sp"
						android:textStyle="bold" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_download"
						android:layout_width="match_parent"
						android:layout_height="36dp"
						android:layout_marginTop="4dp"
						android:backgroundTint="#556579"
						android:fontFamily="sans-serif-condensed"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:text="@string/download"
						android:textAllCaps="false"
						android:textColor="@android:color/white"
						android:textSize="20sp"
						android:textStyle="bold" />

				</LinearLayout>

			</LinearLayout>

			<LinearLayout
				android:id="@+id/layout_info"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:background="@drawable/bg_nsfw_browser_card"
				android:orientation="vertical">

				<TextView
					android:id="@+id/textView_title"
					android:layout_width="match_parent"
					android:layout_height="34dp"
					android:background="@drawable/bg_nsfw_browser_title"
					android:ellipsize="end"
					android:fontFamily="sans-serif-condensed"
					android:gravity="center_vertical"
					android:maxLines="1"
					android:paddingHorizontal="10dp"
					android:shadowColor="#CC5D2028"
					android:shadowDx="1.2"
					android:shadowDy="1.2"
					android:shadowRadius="1.5"
					android:textColor="@android:color/white"
					android:textSize="22sp"
					android:textStyle="bold"
					tools:text="Living In A Daydream" />

				<TextView
					android:id="@+id/textView_subtitle"
					android:layout_width="match_parent"
					android:layout_height="32dp"
					android:background="@drawable/bg_nsfw_browser_subtitle"
					android:ellipsize="end"
					android:fontFamily="sans-serif"
					android:gravity="center_vertical"
					android:maxLines="1"
					android:paddingHorizontal="10dp"
					android:textColor="#5E1F27"
					android:textSize="19sp"
					tools:text="N/A" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginHorizontal="10dp"
					android:layout_marginTop="8dp"
					android:orientation="vertical">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_group"
							android:textColor="#606060"
							android:textSize="18sp" />

						<TextView
							android:id="@+id/textView_group"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:textColor="#5E1F27"
							android:textSize="18sp"
							tools:text="N/A" />

					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_type"
							android:textColor="#606060"
							android:textSize="18sp" />

						<TextView
							android:id="@+id/textView_type"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:textColor="#5E1F27"
							android:textSize="18sp"
							tools:text="Doujinshi" />

					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_language"
							android:textColor="#606060"
							android:textSize="18sp" />

						<TextView
							android:id="@+id/textView_language"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:textColor="#5E1F27"
							android:textSize="18sp"
							tools:text="English" />

					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_series"
							android:textColor="#606060"
							android:textSize="18sp" />

						<TextView
							android:id="@+id/textView_series"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:textColor="#5E1F27"
							android:textSize="18sp"
							tools:text="Bang Dream" />

					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_characters"
							android:textColor="#606060"
							android:textSize="18sp" />

						<com.google.android.material.chip.ChipGroup
							android:id="@+id/chipGroup_characters"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							app:chipSpacingHorizontal="4dp"
							app:chipSpacingVertical="4dp"
							app:singleLine="false"
							tools:ignore="SpeakableTextPresentCheck" />

					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<TextView
							android:layout_width="88dp"
							android:layout_height="wrap_content"
							android:text="@string/browser_tags"
							android:textColor="#606060"
							android:textSize="18sp" />

						<com.google.android.material.chip.ChipGroup
							android:id="@+id/chipGroup_tags"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							app:chipSpacingHorizontal="4dp"
							app:chipSpacingVertical="4dp"
							app:singleLine="false"
							tools:ignore="SpeakableTextPresentCheck" />

					</LinearLayout>

				</LinearLayout>

				<TextView
					android:id="@+id/textView_footer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginHorizontal="10dp"
					android:layout_marginTop="14dp"
					android:layout_marginBottom="14dp"
					android:fontFamily="sans-serif"
					android:textColor="#C28186"
					android:textSize="18sp"
					tools:text="Jun 2, 2026, 8:19 PM" />

			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerView_pages"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:nestedScrollingEnabled="false"
				tools:itemCount="9"
				tools:listitem="@layout/item_nsfw_browser_page" />

			<LinearLayout
				android:id="@+id/layout_related"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible">

				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="48dp"
					android:background="@drawable/bg_nsfw_browser_header"
					android:paddingHorizontal="12dp"
					android:paddingVertical="5dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="start|top"
						android:fontFamily="sans-serif-condensed"
						android:shadowColor="#99390B13"
						android:shadowDx="1"
						android:shadowDy="1"
						android:shadowRadius="1.5"
						android:text="@string/browser_related_galleries"
						android:textColor="@android:color/white"
						android:textSize="21sp"
						android:textStyle="bold" />

				</FrameLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerView_related"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:nestedScrollingEnabled="false"
					tools:itemCount="2"
					tools:listitem="@layout/item_nsfw_browser_entry" />

			</LinearLayout>

		</LinearLayout>

	</androidx.core.widget.NestedScrollView>

	<com.google.android.material.progressindicator.CircularProgressIndicator
		android:id="@+id/progress"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:indeterminate="true"
		tools:visibility="visible" />

	<TextView
		android:id="@+id/text_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:gravity="center"
		android:padding="32dp"
		android:text="@string/no_browser_pages"
		android:textColor="#606060"
		android:textSize="16sp"
		android:visibility="gone"
		tools:visibility="visible" />

</FrameLayout>
